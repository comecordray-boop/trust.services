---
import type { Dictionary } from '../i18n/content';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="reveal band">
  <div class="band-photo toned"></div>
  <div class="band-fade"></div>
  <div class="pad band-inner">
    <div class="mono band-kicker">{t.band.kicker}</div>
    <div class="band-line">{t.band.line}</div>
  </div>
</section>

<style>
  .band {
    position: relative;
    height: 440px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .band-photo {
    position: absolute;
    inset: 0;
    background: url('/assets/ext-rear3q.jpg') center 40% / cover;
    background-color: var(--bg-card);
  }
  .band-fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(16, 18, 20, 0.82) 0%, rgba(16, 18, 20, 0.35) 45%, rgba(16, 18, 20, 0.1) 100%),
      linear-gradient(0deg, #101214 0%, rgba(16, 18, 20, 0) 40%);
  }
  .band-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 48px;
  }
  .band-kicker {
    font-size: 11px;
    color: var(--text-2);
    letter-spacing: 0.14em;
  }
  .band-line {
    font-size: 34px;
    line-height: 1.14;
    letter-spacing: -0.015em;
    font-weight: 600;
    max-width: 560px;
    margin-top: 16px;
  }

  @media (max-width: 900px) {
    .band {
      height: 340px !important;
    }
    .band-line {
      font-size: 26px !important;
    }
    .band-inner {
      padding: 0 22px !important;
    }
  }
</style>
