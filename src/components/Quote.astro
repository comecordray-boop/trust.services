---
import type { Dictionary } from '../i18n/content';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const q = t.quote;
const f = q.fields;

// Données passées au script client (mailto localisé)
const mailConfig = {
  email: q.email,
  subject: q.mail.subject,
  labels: q.mail.labels,
  dash: '—',
};
---

<section id="devis" class="quote">
  <div class="pad reveal q-head">
    <div>
      <div class="mono kicker">{q.kicker}</div>
      <h2 class="q-h2" set:html={q.h2Html} />
    </div>
    <div class="mono q-meta">
      <div>{q.meta1}</div>
      <div>{q.meta2}</div>
      <a href={`mailto:${q.email}`}>{q.email}</a>
    </div>
  </div>

  <form class="pad q-form" data-quote-form data-mail={JSON.stringify(mailConfig)}>
    <div class="form-grid">
      <input name="nom" required class="fld" placeholder={f.name} autocomplete="name" />
      <input name="email" type="email" required class="fld" placeholder={f.email} autocomplete="email" />

      <select name="mission" class="fld">
        <option value="">{f.missionPlaceholder}</option>
        {f.missionOptions.map((o) => <option>{o}</option>)}
      </select>

      <select name="chauffeur" class="fld">
        <option value="">{f.driverPlaceholder}</option>
        {f.driverOptions.map((o) => <option>{o}</option>)}
      </select>

      <input name="dates" class="fld" placeholder={f.dates} />
      <input name="lieu" class="fld" placeholder={f.place} />

      <select name="passagers" class="fld full">
        <option value="">{f.paxPlaceholder}</option>
        {f.paxOptions.map((o) => <option>{o}</option>)}
      </select>

      <textarea name="message" rows="4" class="fld full msg" placeholder={f.message}></textarea>
    </div>

    <div class="q-actions">
      <button type="submit" class="btn-primary q-submit">{q.submit}</button>
      <span class="mono q-note">{q.note}</span>
    </div>

    <div class="mono q-success" data-quote-success hidden>{q.success}</div>
  </form>
</section>

<style>
  .quote {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
  }
  .q-head {
    padding: 72px 48px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-end;
  }
  .kicker {
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.14em;
  }
  .q-h2 {
    font-size: 38px;
    line-height: 1.12;
    letter-spacing: -0.015em;
    font-weight: 600;
    margin: 18px 0 0;
  }
  .q-meta {
    font-size: 12px;
    color: var(--text-3);
    text-align: right;
    line-height: 1.8;
  }
  .q-meta a {
    color: var(--text);
  }

  .q-form {
    padding: 40px 48px 76px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .full {
    grid-column: 1 / -1;
  }
  .msg {
    resize: vertical;
  }
  .q-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: 22px;
  }
  .q-submit {
    padding: 16px 34px;
  }
  .q-note {
    font-size: 11.5px;
    color: var(--text-3);
  }
  .q-success {
    margin-top: 22px;
    padding: 16px 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: var(--bg-card);
    font-size: 13px;
    color: var(--text);
  }
  .q-success[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .q-head {
      padding: 52px 22px 0 !important;
    }
    .q-h2 {
      font-size: 28px !important;
    }
    .q-meta {
      text-align: left;
    }
    .q-form {
      padding: 28px 22px 60px !important;
    }
    .form-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  // Soumission du formulaire de devis :
  // ouvre le client mail pré-rempli (mailto) et affiche la confirmation.
  // À remplacer côté prod par un vrai envoi (Formspree / API / serverless).
  type MailConfig = { email: string; subject: string; labels: string[]; dash: string };

  document.querySelectorAll<HTMLFormElement>('form[data-quote-form]').forEach((form) => {
    const success = form.querySelector<HTMLElement>('[data-quote-success]');
    let cfg: MailConfig;
    try {
      cfg = JSON.parse(form.dataset.mail || '{}');
    } catch {
      return;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const val = (name: string) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        return (el && el.value.trim()) || cfg.dash;
      };

      const L = cfg.labels;
      const body = [
        `${L[0]}: ${val('nom')}`,
        `${L[1]}: ${val('email')}`,
        `${L[2]}: ${val('mission')}`,
        `${L[3]}: ${val('chauffeur')}`,
        `${L[4]}: ${val('dates')}`,
        `${L[5]}: ${val('lieu')}`,
        `${L[6]}: ${val('passagers')}`,
        '',
        `${L[7]}:`,
        val('message'),
      ].join('\n');

      const href =
        `mailto:${cfg.email}?subject=${encodeURIComponent(cfg.subject)}` +
        `&body=${encodeURIComponent(body)}`;
      window.location.href = href;

      if (success) success.hidden = false;
    });
  });
</script>
